# Keep both this flag and DEV_AGENT_ENABLED in the production bot disabled until rollout.
TTD_DEV_AGENT_ENABLED=false
TTD_DEV_SOCKET_PATH=/run/ttd-dev-agent/controller.sock
# Numeric gid of the Unix group running ttd-bot.
TTD_DEV_SOCKET_GID=0
TTD_DEV_STATE_ROOT=/var/lib/ttd-dev-agent
TTD_DEV_REPOSITORY=/home/ttd/deploy/ttd-bot
TTD_DEV_MAX_SLOTS=3
TTD_DEV_OWNER_UID_BASE=250000

TTD_DEV_MODEL_PROVIDER=xiaomi-token-plan-cn
TTD_DEV_MODEL_ID=mimo-v2.5-pro
TTD_DEV_MODEL_THINKING=high
TTD_DEV_MODEL_API_KEY=

TTD_DEV_GONDOLIN_IMAGE=ttd-dev-agent:latest
TTD_DEV_INGRESS_HOST=127.0.0.1
TTD_DEV_INGRESS_PORT=9910
# One independent high-entropy Bearer token per configured slot.
TTD_DEV_SLOT_INGRESS_SECRETS=

TTD_DEV_GITHUB_APP_ID=
TTD_DEV_GITHUB_INSTALLATION_ID=
TTD_DEV_GITHUB_PRIVATE_KEY_PATH=/etc/ttd-dev-agent/github-app.pem
TTD_DEV_GITHUB_REPOSITORY=trytodupe/ttd-bot
