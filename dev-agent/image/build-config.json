{
  "arch": "x86_64",
  "distro": "alpine",
  "env": {
    "LANG": "C.UTF-8",
    "UV_LINK_MODE": "copy"
  },
  "alpine": {
    "version": "3.21.3",
    "branch": "v3.21",
    "rootfsPackages": [
      "bash",
      "build-base",
      "ca-certificates",
      "cargo",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "ffmpeg",
      "freetype-dev",
      "git",
      "jpeg-dev",
      "libffi-dev",
      "linux-headers",
      "linux-virt",
      "openblas-dev",
      "openssl-dev",
      "postgresql17",
      "postgresql17-client",
      "postgresql17-dev",
      "py3-aiohttp",
      "py3-pip",
      "python3",
      "python3-dev",
      "ripgrep",
      "rust",
      "uv",
      "zlib-dev"
    ],
    "initramfsPackages": [
      "linux-virt",
      "kmod"
    ]
  },
  "rootfs": {
    "label": "ttd-dev-agent",
    "sizeMb": 4096
  },
  "init": {
    "rootfsInitExtra": "../guest/rootfs-init-extra.sh"
  },
  "postBuild": {
    "copy": [
      {
        "src": "../guest",
        "dest": "/opt/ttd-dev-agent"
      },
      {
        "src": "../../pyproject.toml",
        "dest": "/opt/ttd-dev-agent/base-python/pyproject.toml"
      },
      {
        "src": "../../uv.lock",
        "dest": "/opt/ttd-dev-agent/base-python/uv.lock"
      }
    ],
    "commands": [
      "chmod 0555 /opt/ttd-dev-agent/staging_bot.py /opt/ttd-dev-agent/slot_proxy.py /opt/ttd-dev-agent/workspace_file.py",
      "mkdir -p /workspaces /run/ttd-dev-agent",
      "chmod 0711 /workspaces",
      "pg_versions set-default 17 || test -x /usr/bin/psql",
      "test -e /dev/null || mknod -m 0666 /dev/null c 1 3",
      "test -e /dev/zero || mknod -m 0666 /dev/zero c 1 5",
      "test -e /dev/random || mknod -m 0666 /dev/random c 1 8",
      "test -e /dev/urandom || mknod -m 0666 /dev/urandom c 1 9",
      "TMPDIR=/tmp python3 -m pip install --break-system-packages uv==0.11.21",
      "python3 -m venv /opt/ttd-dev-agent/base-python/.venv",
      "cd /opt/ttd-dev-agent/base-python && UV_LIBC=musl uv export --frozen --no-emit-project --no-hashes --format requirements-txt >/tmp/base-requirements.txt && .venv/bin/python -m pip install --no-cache-dir -r /tmp/base-requirements.txt && rm -f /tmp/base-requirements.txt",
      "sha256sum /opt/ttd-dev-agent/base-python/uv.lock | cut -d' ' -f1 >/opt/ttd-dev-agent/base-lock.sha256",
      "cd /opt/ttd-dev-agent/base-python && sha256sum pyproject.toml uv.lock | sha256sum | cut -d' ' -f1 >/opt/ttd-dev-agent/base-environment.sha256",
      "chmod -R a-w /opt/ttd-dev-agent/base-python /opt/ttd-dev-agent/base-lock.sha256 /opt/ttd-dev-agent/base-environment.sha256"
    ]
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
